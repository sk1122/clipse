Output part1_start.mp4
Set Shell zsh
Set FontSize 18
Set Width 1920
Set Height 1080
Set Padding 24
Set Theme "Catppuccin Mocha"
Set Framerate 30
Set TypingSpeed 55ms

Hide
Type "cd .. && clear && ./kattappa" Enter
Sleep 4s
Show

# 1. establishing shot, then paste the link
Sleep 2s
Type "n"
Sleep 600ms
Type@45ms "https://www.youtube.com/watch?v=qSyo5d-dVzA"
Sleep 1.2s

# 2. pick English captions
Tab
Sleep 300ms
Tab
Sleep 300ms
Tab
Sleep 300ms
Tab
Sleep 700ms
Enter
Sleep 900ms
Down
Sleep 600ms
Enter
Sleep 900ms

# 3. press Start
Shift+Tab
Sleep 250ms
Shift+Tab
Sleep 250ms
Shift+Tab
Sleep 900ms
Enter

# 4. watch it connect, record and start learning the chat
Sleep 35s

# 5. pause the recording until the first clip lands
Hide
Wait+Screen@50m /clips ready/
Sleep 2s
Show

# 6. results
Sleep 4s
Type "c"
Sleep 1.2s
Down
Sleep 1.2s
Up
Sleep 1.5s
Type "k"
Sleep 4s
Hide
Type "q"
